<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/green_light_bg"
    android:padding="16dp"
    tools:context=".WelcomeActivity">

    <!-- Title (Centered) -->
    <TextView
        android:id="@+id/title_welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Welcome to AnonChat"
        android:textColor="@color/green_dark"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Icon (Placed above the Title) -->
    <ImageView
        android:id="@+id/icon_welcome"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_above="@id/title_welcome"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_incognito"
        android:contentDescription="Anonymous chat icon" />

    <!-- Subtitle (Placed below the Title) -->
    <TextView
        android:id="@+id/subtitle_welcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_welcome"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="Chat freely and anonymously. No registration required."
        android:textColor="@color/green_text_light"
        android:textSize="16sp" />

    <!-- Button (Aligned to the bottom of the screen) -->
    <Button
        android:id="@+id/get_started_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="64dp"
        android:backgroundTint="@color/green_primary"
        android:text="Get Started"
        android:textColor="@color/white"
        android:textSize="18sp" />

</RelativeLayout>

